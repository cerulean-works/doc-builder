{
	"name": "kit",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && pagefind --site build",
		"preview": "vite preview",
		"dev:fixture": "node scripts/fixture.js dev",
		"build:fixture": "node scripts/fixture.js build",
		"test:highlight": "node --test preprocessors/highlight.test.js",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check --plugin prettier-plugin-svelte .",
		"eslint": "eslint .",
		"format": "prettier --write --plugin prettier-plugin-svelte ."
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@fontsource/geist": "^5.3.0",
		"@fontsource/host-grotesk": "^5.3.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.27.1",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@tailwindcss/postcss": "^4.1.18",
		"@types/node": "^20.6.5",
		"cheerio": "^1.0.0-rc.12",
		"domutils": "^2.8.0",
		"eslint": "^10.6.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.14.0",
		"globals": "^16.5.0",
		"highlight.js": "^11.8.0",
		"html-tags": "^3.3.1",
		"htmlparser2": "^7.2.0",
		"katex": "^0.16.22",
		"mdsvex": "^0.12.6",
		"mermaid": "^11.12.0",
		"pagefind": "^1.5.2",
		"postcss": "^8.5.6",
		"postcss-load-config": "^6.0.1",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.4.0",
		"prettier-plugin-tailwindcss": "^0.6.14",
		"svelte": "^5.45.6",
		"svelte-check": "^4.3.6",
		"tailwindcss": "^4.1.18",
		"tslib": "^2.4.1",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.46.4",
		"unist-util-visit": "^5.0.0",
		"vite": "^7.3.4"
	},
	"type": "module",
	"packageManager": "pnpm@12.4.1"
}
